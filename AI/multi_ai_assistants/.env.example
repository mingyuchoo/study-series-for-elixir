# scripts/run.sh loads a project-root .env for local development.
# Direct mix commands and deployments need environment variables set separately.

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Azure 포털의 "배포(Deployment) 이름" — 모델 이름이 아니라 배포 시 지정한 이름이어야 합니다.
# (예: gpt-4o, gpt-4o-mini, my-gpt5-mini 등 실제 만든 배포 이름)
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# 선택: 설정하면 실제 임베딩 + HNSW 인덱스를 사용합니다. 미설정 시 키워드 검색을 사용합니다.
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# 에이전트 실행별 사용량 상한
MAX_MODEL_CALLS_PER_RUN=18
MAX_TOOL_CALLS_PER_RUN=24
MAX_TOKENS_PER_RUN=60000

# Firecrawl MCP Configuration
# API 키 발급: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Context7 MCP Configuration
# API 키 발급: https://context7.com/dashboard
CONTEXT7_API_KEY=your-context7-api-key-here

# Filesystem MCP Configuration
# 이 경로 아래만 MCP 파일 접근 대상으로 등록하세요.
MCP_FILESYSTEM_ROOT=/absolute/path/to/multi_ai_assistants/workspace

# Workspace (업로드 파일 및 에이전트 파일 시스템 툴의 작업 디렉토리)
# 미설정 시 개발환경은 config/workspace 사용
WORKSPACE_DIR=/absolute/path/to/workspace

# Seed 초기 관리자 계정 (seeds.exs 실행 시 사용)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-please-at-least-12-chars
# 관리 UI 접근 권한은 별도 허용 목록으로 설정합니다.
ADMIN_EMAILS=admin@example.com

# Database (production only)
DATABASE_PATH=/path/to/multi_ai_assistants.db

# Phoenix (production only)
# 생성: mix phx.gen.secret
SECRET_KEY_BASE=your-secret-key-base-here
PHX_HOST=localhost
PORT=4000

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Agentic AI" suffix=" · Agentic AI">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        window.addEventListener("phx:toggle-theme", () => {
          const storedTheme = localStorage.getItem("phx:theme");
          const currentTheme = storedTheme || document.documentElement.dataset.theme || "light";
          setTheme(currentTheme === "dark" ? "light" : "dark");
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <div class="carbon-top-nav navbar bg-base-100 sticky top-0 z-30 border-b border-base-300 px-4">
      <div class="navbar-start">
        <.link navigate={~p"/"} class="btn btn-ghost text-xl gap-2 normal-case">
          <span class="inline-block size-4 bg-primary" aria-hidden="true"></span>
          <span>Agentic AI</span>
        </.link>
        <%= if assigns[:current_user] do %>
          <ul class="menu menu-horizontal hidden md:flex px-1 gap-1">
            <li><.link navigate={~p"/chat"}>Chat</.link></li>
            <li>
              <details id="admin-menu" phx-hook="CloseOnOutsideClick">
                <summary>Admin</summary>
                <ul class="dropdown-content menu bg-base-100 z-40 w-52 border border-base-300 p-2">
                  <li><.link navigate={~p"/admin/agents"}>에이전트</.link></li>
                  <li><.link navigate={~p"/admin/mcps"}>MCP 서버</.link></li>
                  <li><.link navigate={~p"/admin/rag"}>RAG</.link></li>
                  <li><.link navigate={~p"/admin/dashboard/home"}>대시보드</.link></li>
                </ul>
              </details>
            </li>
          </ul>
        <% end %>
      </div>

      <div class="navbar-end gap-2">
        <.theme_toggle />

        <%= if assigns[:current_user] do %>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2">
              <div class="avatar placeholder">
                <div class="bg-primary text-primary-content w-7">
                  <span class="text-xs">
                    {String.first(@current_user.email) |> String.upcase()}
                  </span>
                </div>
              </div>
              <span class="hidden sm:inline text-sm">{@current_user.email}</span>
            </div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content bg-base-100 z-40 mt-3 w-56 border border-base-300 p-2"
            >
              <li class="menu-title">
                <span class="truncate">{@current_user.email}</span>
              </li>
              <li><.link navigate={~p"/users/settings"}>설정</.link></li>
              <li class="md:hidden"><.link navigate={~p"/chat"}>Chat</.link></li>
              <li class="md:hidden"><.link navigate={~p"/admin/agents"}>에이전트</.link></li>
              <li class="md:hidden"><.link navigate={~p"/admin/mcps"}>MCP 서버</.link></li>
              <li class="md:hidden"><.link navigate={~p"/admin/rag"}>RAG</.link></li>
              <li class="md:hidden"><.link navigate={~p"/admin/dashboard/home"}>대시보드</.link></li>
              <li></li>
              <li>
                <.link href={~p"/users/log_out"} method="delete" class="text-error">
                  로그아웃
                </.link>
              </li>
            </ul>
          </div>
        <% else %>
          <.link navigate={~p"/users/log_in"} class="btn btn-ghost btn-sm">로그인</.link>
          <.link navigate={~p"/users/register"} class="btn btn-primary btn-sm">회원가입</.link>
        <% end %>
      </div>
    </div>

    <main class="min-h-[calc(100vh-4rem)]">
      {@inner_content}
    </main>

    <Layouts.flash_group flash={@flash} />
  </body>
</html>

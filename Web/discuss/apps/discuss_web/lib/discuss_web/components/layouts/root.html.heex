<!DOCTYPE html>
<html lang="ko" class="h-full" data-theme="discuss">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · 토픽 관리 시스템">
      <%= assigns[:page_title] || "토픽 관리" %>
    </.live_title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="h-full bg-base-200">
    <div class="min-h-full">
      <!-- DaisyUI Navbar -->
      <div class="navbar bg-primary text-primary-content">
        <div class="navbar-start">
          <!-- 모바일 드롭다운 -->
          <div class="dropdown">
            <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
              </svg>
            </div>
            <ul tabindex="0" class="menu menu-sm dropdown-content bg-primary rounded-box z-[1] mt-3 w-52 p-2 shadow">
              <li><a href="/" class="text-primary-content">홈</a></li>
              <%= if assigns[:current_user] do %>
                <%= if assigns[:is_admin] do %>
                  <li><a href={~p"/admin/users"} class="text-primary-content">관리자</a></li>
                <% end %>
                <li>
                  <.link href={~p"/users/log_out"} method="delete" class="text-primary-content">
                    로그아웃
                  </.link>
                </li>
              <% else %>
                <li><a href={~p"/users/log_in"} class="text-primary-content">로그인</a></li>
                <li><a href={~p"/users/register"} class="text-primary-content">회원가입</a></li>
              <% end %>
            </ul>
          </div>
          <a href="/" class="btn btn-ghost text-xl">토픽 관리 시스템</a>
        </div>
        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1">
            <li><a href="/" class="text-primary-content">홈</a></li>
          </ul>
        </div>
        <div class="navbar-end hidden lg:flex">
          <%= if assigns[:current_user] do %>
            <span class="text-primary-content/70 text-sm mr-4">
              <%= @current_user.email %>
            </span>
            <%= if assigns[:is_admin] do %>
              <a href={~p"/admin/users"} class="btn btn-ghost btn-sm text-primary-content">
                관리자
              </a>
            <% end %>
            <.link
              href={~p"/users/log_out"}
              method="delete"
              class="btn btn-ghost btn-sm text-primary-content"
            >
              로그아웃
            </.link>
          <% else %>
            <a href={~p"/users/log_in"} class="btn btn-ghost btn-sm text-primary-content">
              로그인
            </a>
            <a href={~p"/users/register"} class="btn btn-sm bg-base-100 text-primary hover:bg-base-200 border-0 ml-2">
              회원가입
            </a>
          <% end %>
        </div>
      </div>

      <main>
        <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
          <%= @inner_content %>
        </div>
      </main>
    </div>
  </body>
</html>

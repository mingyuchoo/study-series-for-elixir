<div class="mx-auto max-w-sm mt-10">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl mb-4">회원가입</h2>

      <.simple_form :let={f} for={@changeset} action={~p"/users/register"}>
        <.error :if={@changeset.action}>
          오류가 발생했습니다. 아래 내용을 확인해주세요.
        </.error>

        <.input field={f[:email]} type="email" label="이메일" required />
        <.input field={f[:password]} type="password" label="비밀번호" required />

        <:actions>
          <.button phx-disable-with="계정 생성 중..." class="w-full">
            회원가입
          </.button>
        </:actions>
      </.simple_form>

      <p class="text-center text-sm text-base-content/60 mt-4">
        이미 계정이 있으신가요?
        <.link navigate={~p"/users/log_in"} class="link link-primary font-semibold">
          로그인
        </.link>
      </p>
    </div>
  </div>
</div>

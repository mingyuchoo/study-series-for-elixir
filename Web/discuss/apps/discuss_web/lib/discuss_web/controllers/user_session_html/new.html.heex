<div class="mx-auto max-w-sm mt-10">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl mb-4">로그인</h2>

      <%= if @error_message do %>
        <div class="alert alert-error mb-4">
          <span><%= @error_message %></span>
        </div>
      <% end %>

      <.simple_form :let={f} for={%{}} as={:user} action={~p"/users/log_in"}>
        <.input field={f[:email]} type="email" label="이메일" required />
        <.input field={f[:password]} type="password" label="비밀번호" required />

        <div class="flex items-center justify-between mt-4">
          <label class="label cursor-pointer gap-2">
            <input type="checkbox" name="user[remember_me]" value="true" class="checkbox checkbox-primary checkbox-sm" />
            <span class="label-text">로그인 유지</span>
          </label>
          <.link navigate={~p"/users/reset_password"} class="link link-primary text-sm">
            비밀번호를 잊으셨나요?
          </.link>
        </div>

        <:actions>
          <.button phx-disable-with="로그인 중..." class="w-full">
            로그인
          </.button>
        </:actions>
      </.simple_form>

      <p class="text-center text-sm text-base-content/60 mt-4">
        계정이 없으신가요?
        <.link navigate={~p"/users/register"} class="link link-primary font-semibold">
          회원가입
        </.link>
      </p>
    </div>
  </div>
</div>

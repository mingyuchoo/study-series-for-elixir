<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold text-base-content">관리자 - 사용자 관리</h1>
      <p class="mt-2 text-sm text-base-content/70">등록된 사용자 목록입니다.</p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <a href={~p"/admin/users/new"} class="btn btn-primary btn-sm">
        <i class="material-icons">add</i>
        사용자 추가
      </a>
    </div>
  </div>

  <div class="mt-8">
    <%= if Enum.empty?(@users) do %>
      <div class="card bg-base-100 shadow">
        <div class="card-body items-center text-center">
          <p class="text-sm text-base-content/60">등록된 사용자가 없습니다.</p>
        </div>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>이름</th>
              <th>이메일</th>
              <th>역할</th>
              <th>주소</th>
              <th class="text-right">작업</th>
            </tr>
          </thead>
          <tbody>
            <%= for user <- @users do %>
              <tr class="hover">
                <td class="font-medium"><%= user.name %></td>
                <td><%= user.email %></td>
                <td>
                  <span class={"badge #{if user.role == "admin", do: "badge-primary", else: "badge-success"} badge-sm"}>
                    <%= user.role %>
                  </span>
                </td>
                <td><%= user.address %></td>
                <td>
                  <div class="flex justify-end gap-1">
                    <a href={~p"/admin/users/#{user.id}"} class="btn btn-info btn-xs btn-outline" title="보기">
                      <i class="material-icons">visibility</i>
                    </a>
                    <a href={~p"/admin/users/#{user.id}/edit"} class="btn btn-warning btn-xs btn-outline" title="수정">
                      <i class="material-icons">edit</i>
                    </a>
                    <a href="#" onclick={"event.preventDefault(); document.getElementById('admin-delete-#{user.id}').submit();"} class="btn btn-error btn-xs btn-outline" title="삭제">
                      <i class="material-icons">delete</i>
                    </a>
                    <form id={"admin-delete-#{user.id}"} action={~p"/admin/users/#{user.id}"} method="post" class="hidden">
                      <input type="hidden" name="_method" value="delete">
                      <input type="hidden" name="_csrf_token" value={get_csrf_token()}>
                    </form>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold text-base-content">토픽 목록</h1>
      <p class="mt-2 text-sm text-base-content/70">
        모든 토픽의 목록입니다. 토픽을 추가, 수정, 삭제할 수 있습니다.
      </p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <a href="/topics/new" class="btn btn-primary btn-sm">
        <i class="material-icons">add</i>
        토픽 추가
      </a>
    </div>
  </div>

  <!-- 검색 & 필터 -->
  <div class="mt-4">
    <form action={~p"/topics"} method="get" class="flex flex-wrap gap-3 items-center">
      <div class="flex-1 min-w-[200px]">
        <input
          type="text"
          name="search"
          value={@search}
          placeholder="토픽 제목 또는 본문 검색..."
          class="input input-bordered w-full input-sm"
        />
      </div>
      <label class="label cursor-pointer gap-2">
        <input
          type="checkbox"
          name="my_topics"
          value="true"
          checked={@my_topics}
          class="checkbox checkbox-primary checkbox-sm"
        />
        <span class="label-text">내 토픽만</span>
      </label>
      <button type="submit" class="btn btn-ghost btn-sm border border-base-300">
        <i class="material-icons">search</i>
        검색
      </button>
      <a href={~p"/topics"} class="btn btn-ghost btn-sm border border-base-300">
        초기화
      </a>
    </form>
  </div>

  <div class="mt-6">
    <%= if Enum.empty?(@topics) do %>
      <div class="card bg-base-100 shadow">
        <div class="card-body items-center text-center py-12">
          <div class="rounded-full bg-base-200 p-3 inline-block">
            <i class="material-icons text-base-content/40 text-3xl">topic</i>
          </div>
          <h3 class="mt-2 text-sm font-medium">현재 등록된 토픽이 없습니다</h3>
          <p class="mt-1 text-sm text-base-content/60">첫 번째 토픽을 만들어보세요.</p>
          <div class="mt-6">
            <a href="/topics/new" class="btn btn-primary btn-sm">
              <i class="material-icons">add</i>
              첫 번째 토픽 만들기
            </a>
          </div>
        </div>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>토픽</th>
              <th class="text-right">작업</th>
            </tr>
          </thead>
          <tbody>
            <%= for topic <- @topics do %>
              <tr class="hover">
                <td>
                  <div class="font-medium"><%= topic.title %></div>
                  <%= if topic.body && topic.body != "" do %>
                    <div class="mt-1 text-base-content/60 text-xs truncate max-w-md">
                      <%= Discuss.Markdown.excerpt(topic.body, 100) %>
                    </div>
                  <% end %>
                </td>
                <td>
                  <div class="flex justify-end gap-1">
                    <a href={~p"/topics/#{topic.id}"} class="btn btn-info btn-xs btn-outline" title="상세보기">
                      <i class="material-icons">visibility</i>
                      <span class="hidden sm:inline">상세</span>
                    </a>
                    <%= if topic.auth_user_id == @current_user.id do %>
                      <a href={~p"/topics/#{topic.id}/edit"} class="btn btn-warning btn-xs btn-outline" title="수정">
                        <i class="material-icons">edit</i>
                        <span class="hidden sm:inline">수정</span>
                      </a>
                      <a href="#" onclick={"event.preventDefault(); document.getElementById('delete-form-#{topic.id}').submit();"} class="btn btn-error btn-xs btn-outline" title="삭제">
                        <i class="material-icons">delete</i>
                        <span class="hidden sm:inline">삭제</span>
                      </a>
                      <form id={"delete-form-#{topic.id}"} action={~p"/topics/#{topic.id}"} method="post" class="hidden">
                        <input type="hidden" name="_method" value="delete">
                        <input type="hidden" name="_csrf_token" value={get_csrf_token()}>
                      </form>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- 페이지네이션 -->
  <%= if @total > @per_page do %>
    <% total_pages = ceil(@total / @per_page) %>
    <div class="mt-4 flex items-center justify-between">
      <p class="text-sm text-base-content/70">
        전체 <strong><%= @total %></strong>개 중
        <strong><%= (@page - 1) * @per_page + 1 %></strong> -
        <strong><%= min(@page * @per_page, @total) %></strong>
      </p>
      <div class="join">
        <%= if @page > 1 do %>
          <a href={~p"/topics?#{[page: @page - 1, search: @search, my_topics: @my_topics]}"} class="join-item btn btn-sm">
            이전
          </a>
        <% end %>
        <%= for p <- max(1, @page - 2)..min(total_pages, @page + 2) do %>
          <a href={~p"/topics?#{[page: p, search: @search, my_topics: @my_topics]}"} class={"join-item btn btn-sm #{if p == @page, do: "btn-primary", else: ""}"}>
            <%= p %>
          </a>
        <% end %>
        <%= if @page < total_pages do %>
          <a href={~p"/topics?#{[page: @page + 1, search: @search, my_topics: @my_topics]}"} class="join-item btn btn-sm">
            다음
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

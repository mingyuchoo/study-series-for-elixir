<div class="mx-auto max-w-sm mt-10">
  <div class="bg-white shadow-md rounded-lg px-8 pt-6 pb-8 mb-4">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-2">새 비밀번호 설정</h2>

    <.simple_form :let={f} for={@changeset} action={~p"/users/reset_password/#{@token}"} method="put">
      <.input field={f[:password]} type="password" label="새 비밀번호" required />
      <.input field={f[:password_confirmation]} type="password" label="비밀번호 확인" required />
      <:actions>
        <.button class="w-full bg-indigo-600 hover:bg-indigo-700">
          비밀번호 재설정
        </.button>
      </:actions>
    </.simple_form>

    <p class="text-center text-sm text-gray-600 mt-4">
      <.link navigate={~p"/users/log_in"} class="font-semibold text-indigo-600 hover:text-indigo-500">
        로그인으로 돌아가기
      </.link>
    </p>
  </div>
</div>

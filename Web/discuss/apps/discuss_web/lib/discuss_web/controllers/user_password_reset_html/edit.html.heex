<div class="mx-auto max-w-sm mt-10">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl mb-2">새 비밀번호 설정</h2>

      <.simple_form :let={f} for={@changeset} action={~p"/users/reset_password/#{@token}"} method="put">
        <.input field={f[:password]} type="password" label="새 비밀번호" required />
        <.input field={f[:password_confirmation]} type="password" label="비밀번호 확인" required />
        <:actions>
          <.button class="w-full">
            비밀번호 재설정
          </.button>
        </:actions>
      </.simple_form>

      <p class="text-center text-sm text-base-content/60 mt-4">
        <.link navigate={~p"/users/log_in"} class="link link-primary font-semibold">
          로그인으로 돌아가기
        </.link>
      </p>
    </div>
  </div>
</div>
